<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override: allow cleartext (for the emulator loopback 10.0.2.2:8080)
  and do NOT pin, so local/staging backends with any certificate work while
  developing. This file is not part of release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
