# Copy this file to `keystore.properties` and fill in your own values.
# `keystore.properties` is git-ignored and must NEVER be committed.
# Official releases are signed with the maintainer's key; verify the signing
# certificate fingerprint published in the README / release notes.
storeFile=/absolute/path/to/your-release.keystore
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
